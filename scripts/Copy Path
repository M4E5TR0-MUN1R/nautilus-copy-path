#!/usr/bin/env bash
# Nautilus script: copy the selected file path(s) to the clipboard.
# Bound to Ctrl+Shift+C via ~/.config/nautilus/scripts-accels.

paths="${NAUTILUS_SCRIPT_SELECTED_FILE_PATHS%$'\n'}"

# Nothing selected: fall back to the current folder.
if [[ -z "$paths" && "$NAUTILUS_SCRIPT_CURRENT_URI" == file://* ]]; then
    paths="$(python3 -c 'import sys, urllib.parse; print(urllib.parse.unquote(urllib.parse.urlparse(sys.argv[1]).path))' "$NAUTILUS_SCRIPT_CURRENT_URI")"
fi

[[ -z "$paths" ]] && exit 0

if [[ -n "$WAYLAND_DISPLAY" ]] && command -v wl-copy >/dev/null; then
    printf '%s' "$paths" | wl-copy
elif command -v xclip >/dev/null; then
    printf '%s' "$paths" | xclip -selection clipboard
else
    notify-send "Copy Path" "Install wl-clipboard or xclip" 2>/dev/null
    exit 1
fi
